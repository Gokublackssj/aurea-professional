---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Pregunta from "../../components/Pregunta.astro";
import { habitaciones, euros, type Habitacion } from "../../data/habitaciones";
import { ruta } from "../../lib/ruta";

export const getStaticPaths = (() =>
  habitaciones.map((habitacion) => ({ params: { slug: habitacion.slug }, props: { habitacion } }))) satisfies GetStaticPaths;

interface Props {
  habitacion: Habitacion;
}

const { habitacion: h } = Astro.props;
const otras = habitaciones.filter((o) => o.slug !== h.slug);
const reservar = ruta(`reservas?habitacion=${h.slug}`);

const datos = [
  ["Superficie", `${h.metros} m²`],
  ...(h.exterior ? [["Exterior", h.exterior]] : []),
  ["Huéspedes", `Hasta ${h.huespedes}`],
  ["Cama", h.cama],
  ["Vista", h.vista],
  ["En la casa", `${h.llaves} ${h.llaves === 1 ? "llave" : "llaves"}`],
];
---

<Base title={h.nombre} description={`${h.nombre} en Aurea: ${h.resumen}`}>
  <section class="portada" aria-labelledby="titulo">
    <div class="portada-foto">
      <!-- Mismo nombre de transición que la foto de esta habitación en la lista
           y en el inicio: al llegar desde allí, la foto viaja hasta aquí. -->
      <Foto foto={h.fotos[0]} sizes="100vw" prioridad anchos={[640, 960, 1280, 1920]} transicion={`foto-${h.slug}`} />
    </div>
    <div class="portada-fila marco" data-entrada>
      <div class="portada-titulo">
        <h1 id="titulo">{h.nombre}</h1>
        <p data-entrada-paso>{h.resumen}</p>
      </div>
      <div class="portada-reserva" data-entrada-paso>
        <p>
          Desde <strong>{euros(h.precio)}</strong> la noche
        </p>
        <a class="boton boton-principal" href={reservar}>Reservar</a>
      </div>
    </div>
  </section>

  <section class="relato marco" aria-labelledby="relato-titulo">
    <h2 id="relato-titulo" class="solo-lector">La habitación</h2>
    <div class="relato-texto" data-revelar="grupo">
      <p class="primero">{h.entradilla}</p>
      {h.descripcion.map((p) => <p>{p}</p>)}
    </div>
    <dl class="datos" data-revelar="grupo">
      {
        datos.map(([t, d]) => (
          <div>
            <dt>{t}</dt>
            <dd>{d}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Galería: cada foto abre el visor a pantalla completa (src/scripts/motion/galeria.ts) -->
  <section class="detalles marco" aria-labelledby="detalles-titulo" data-escena="galeria">
    <h2 id="detalles-titulo" class="solo-lector">Fotografías de {h.conArticulo}</h2>
    <button type="button" class="ampliar detalle-a" data-ampliar data-revelar="foto" aria-label={`Ampliar: ${h.nombre}, foto 1 de 2`}>
      <Foto foto={h.fotos[1]} sizes="(min-width: 48rem) 54vw, 100vw" anchos={[640, 960, 1280, 1600]} />
    </button>
    <button type="button" class="ampliar detalle-b" data-ampliar data-revelar="foto" data-revelar-desde="izquierda" aria-label={`Ampliar: ${h.nombre}, foto 2 de 2`}>
      <Foto foto={h.fotos[2]} sizes="(min-width: 48rem) 30vw, 70vw" anchos={[480, 800, 1000]} />
    </button>
    <dialog class="visor" aria-label={`Fotografías de ${h.conArticulo}`}>
      <div class="visor-foto"></div>
      <p class="visor-pie"></p>
      <div class="visor-controles">
        <button type="button" class="boton visor-anterior" aria-label="Foto anterior">←</button>
        <button type="button" class="boton visor-siguiente" aria-label="Foto siguiente">→</button>
        <button type="button" class="boton visor-cerrar">Cerrar</button>
      </div>
    </dialog>
  </section>

  <section class="equipo marco" aria-labelledby="equipo-titulo">
    <h2 id="equipo-titulo" data-revelar="titulo">En la habitación</h2>
    <ul data-revelar="grupo">
      {h.equipamiento.map((e) => <li>{e}</li>)}
    </ul>
    <p class="equipo-nota">Desayuno, termas y acceso a la poza incluidos. Traslado desde el aeropuerto a partir de tres noches.</p>
  </section>

  <section class="otras marco" aria-labelledby="otras-titulo">
    <h2 id="otras-titulo" data-revelar="titulo">Las otras habitaciones</h2>
    <ul data-revelar="grupo">
      {
        otras.map((o) => (
          <li>
            <a href={ruta(`habitaciones/${o.slug}`)}>
              <Foto foto={o.fotos[0]} sizes="(min-width: 48rem) 30vw, 100vw" anchos={[480, 800, 1000]} transicion={`foto-${o.slug}`} />
              <span class="otra-nombre">{o.nombre}</span>
              <span class="otra-datos">
                {o.metros} m² · desde {euros(o.precio)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Pregunta arriba="¿Cuándo" abajo="llegas?" reservar={reservar} />
</Base>

<style>
  .portada-foto {
    height: 60svh;
    overflow: hidden;
  }

  .portada-foto :global(picture),
  .portada-foto :global(img) {
    width: 100%;
    height: 100%;
  }

  .portada-foto :global(img) {
    object-fit: cover;
  }

  .portada-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-top: 1.5rem;
  }

  .portada-titulo {
    display: grid;
    gap: 1rem;
  }

  h1 {
    font-size: clamp(3rem, 1rem + 8vw, 9.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .portada-titulo p {
    font-size: var(--step-lead);
    line-height: 1.35;
  }

  .portada-reserva {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 0.5rem;
  }

  .portada-reserva strong {
    font-family: var(--display);
    font-size: var(--step-lead);
    font-weight: 500;
  }

  .relato {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 2rem clamp(2rem, 6vw, 8rem);
    margin-top: var(--seccion);
  }

  .relato-texto {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }

  .primero {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .datos {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  dt {
    color: var(--muted);
    font-size: var(--step-small);
  }

  dd {
    margin: 0;
  }

  .detalles {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
    margin-top: var(--seccion);
  }

  /* Fotos que se amplían: botón sin aspecto de botón, con lupa al pasar */
  .ampliar {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
    cursor: zoom-in;
  }

  .ampliar :global(picture),
  .ampliar :global(img) {
    display: block;
    width: 100%;
  }

  .ampliar :global(img) {
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-movimiento="completo"]) .ampliar:hover :global(img) {
    transform: scale(1.04);
  }

  .ampliar:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .detalle-a :global(img) {
    aspect-ratio: 3 / 2;
  }

  .detalle-b {
    margin-top: 30%;
  }

  .detalle-b :global(img) {
    aspect-ratio: 4 / 5;
  }

  /* Visor a pantalla completa */
  .visor {
    width: 100vw;
    max-width: none;
    height: 100svh;
    max-height: none;
    margin: 0;
    padding: clamp(1rem, 3vw, 2.5rem);
    border: 0;
    background: rgb(8 7 6 / 0.96);
    color: var(--ink);
  }

  .visor[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }

  .visor::backdrop {
    background: rgb(8 7 6 / 0.7);
  }

  .visor-foto {
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .visor-foto :global(picture) {
    display: contents;
  }

  .visor-foto :global(img) {
    max-width: 100%;
    max-height: calc(100svh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .visor-pie {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .visor-controles {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: -3.25rem;
  }

  .visor-anterior,
  .visor-siguiente {
    width: 3.25rem;
    padding: 0;
    font-size: var(--step-lead);
  }

  .equipo {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 2rem clamp(2rem, 5vw, 6rem);
    margin-top: var(--seccion);
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--surface);
  }

  .equipo h2,
  .otras h2 {
    font-size: var(--step-head);
  }

  .equipo ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 3rem;
    font-family: var(--display);
    font-size: var(--step-lead);
    line-height: 1.25;
  }

  .equipo-nota {
    grid-column: 2;
    color: var(--muted);
  }

  .otras {
    margin-top: var(--seccion);
  }

  .otras ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem 1.5rem;
    margin-top: 3rem;
  }

  .otras a {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
  }

  .otras a :global(picture) {
    display: block;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }

  .otras a :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(html[data-movimiento="completo"]) .otras a:hover :global(img) {
    transform: scale(1.05);
  }

  .otra-nombre {
    font-family: var(--display);
    font-size: var(--step-lead);
    line-height: 1.1;
  }

  .otras a:hover .otra-nombre {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .otra-datos {
    color: var(--muted);
    font-size: var(--step-small);
  }

  @media (max-width: 47.99rem) {
    .portada-foto {
      height: 56svh;
    }

    .portada-reserva {
      width: 100%;
      justify-content: space-between;
    }

    .relato,
    .detalles,
    .equipo,
    .equipo ul {
      grid-template-columns: 1fr;
    }

    .detalles :global(.detalle-b) {
      width: 70%;
      margin: 0 0 0 auto;
    }

    .equipo-nota {
      grid-column: 1;
    }
  }
</style>
