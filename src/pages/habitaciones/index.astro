---
// Habitaciones. Sin JavaScript, las cuatro se leen una tras otra, cada una con
// su primera foto y su ficha. Con él (src/scripts/motion/habitaciones.ts) se
// convierten en un explorador: pestañas accesibles, foto protagonista con la
// galería de esa habitación (tira de miniaturas, flechas, deslizar) y la ficha.
// Cada galería es de una sola sesión fotográfica: todas muestran el mismo
// espacio. La foto principal comparte nombre de transición con la portada de
// su página de detalle: al entrar en ella, la foto viaja hasta allí.
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Pregunta from "../../components/Pregunta.astro";
import { habitaciones, totalLlaves, euros } from "../../data/habitaciones";
import { fotos } from "../../data/fotos";
import { ruta } from "../../lib/ruta";

const desde = Math.min(...habitaciones.map((h) => h.precio));

const incluido = [
  ["Desayuno", "Hasta las doce, en la habitación, la terraza o la Mesa de Lumbre."],
  ["Termas", "Piscina de agua de mar templada, sauna de piedra y baño de vapor, de 8:00 a 21:00."],
  ["La poza", "Acceso por los 112 escalones a la poza de marea y a la cala de arena negra."],
  ["Traslado", "Desde el aeropuerto, incluido a partir de tres noches."],
  ["Hoja de la tarde", "Cada día, bajo la puerta: la hora del sol, las mareas y lo que hay en la lonja."],
  ["Silencio", "Discos, libros y un ventanal al poniente; en las habitaciones de la casa no hay televisores."],
];

const filas: [string, (h: (typeof habitaciones)[number]) => string][] = [
  ["Superficie", (h) => `${h.metros} m²`],
  ["Huéspedes", (h) => `Hasta ${h.huespedes}`],
  ["Vista", (h) => h.vista],
  ["Exterior", (h) => h.exterior ?? "—"],
  ["Cama", (h) => h.cama],
  ["Baño", (h) => h.bano],
  ["Desde", (h) => `${euros(h.precio)} / noche`],
];
---

<Base title="Habitaciones" description="Veintidós habitaciones en cuatro categorías: estudios, suites y la Residencia Aurea, con fotos de cada espacio.">
  <section class="cabeza marco" aria-labelledby="titulo" data-entrada>
    <span class="etiqueta" data-entrada-paso>Habitaciones · {totalLlaves} en total</span>
    <h1 id="titulo">Habitaciones</h1>
    <div class="cabeza-fila">
      <p class="entradilla" data-entrada-paso>
        Del jardín a la casa entre olivos: cuatro maneras de quedarse. Recórrelas foto a foto: qué se ve desde la cama, qué incluye cada una y
        qué la hace distinta.
      </p>
      <p class="cabeza-datos" data-entrada-paso>
        {habitaciones.length} categorías · desde {euros(desde)} la noche · precios de ejemplo, para dos personas
      </p>
    </div>
  </section>

  <section class="selector marco" aria-label="Las cuatro habitaciones" data-escena="habitaciones">
    <div class="pestanas" role="tablist" aria-label="Elige una habitación" hidden>
      {
        habitaciones.map((h, i) => (
          <button
            type="button"
            role="tab"
            id={`pestana-${h.slug}`}
            aria-controls={h.slug}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-slug={h.slug}
          >
            <span class="pestana-nombre">{h.nombre}</span>
            <span class="pestana-precio">desde {euros(h.precio)}</span>
          </button>
        ))
      }
    </div>
    {
      habitaciones.map((h) => (
        <article id={h.slug} class="hab" data-slug={h.slug} aria-labelledby={`${h.slug}-titulo`}>
          <div class="hab-foto">
            <div class="hab-escena">
              {h.fotos.map((f, i) => (
                <figure class:list={["hab-capa", { actual: i === 0 }]} data-pie={f.pie}>
                  <Foto
                    foto={f.foto}
                    sizes="(min-width: 48rem) 56vw, 100vw"
                    anchos={[640, 960, 1280, 1600, 2000]}
                    transicion={i === 0 ? `foto-${h.slug}` : undefined}
                    style={f.foco ? `object-position: ${f.foco}` : undefined}
                  />
                </figure>
              ))}
              <p class="hab-rotulo" aria-hidden="true">
                <span class="hab-rotulo-nombre">{h.nombre}</span>
                <span class="hab-rotulo-pie">{h.fotos[0].pie}</span>
              </p>
            </div>
            <div class="tira" hidden>
              <button type="button" class="tira-paso" data-paso="-1" aria-label={`Foto anterior de ${h.conArticulo}`}>
                ←
              </button>
              <ol class="tira-fotos" aria-label={`Fotos de ${h.conArticulo}`}>
                {h.fotos.map((f, i) => (
                  <li>
                    <button type="button" data-i={i} aria-current={i === 0 ? "true" : "false"} aria-label={`Foto ${i + 1} de ${h.fotos.length}: ${fotos[f.foto].alt}`}>
                      <Foto foto={f.foto} sizes="5rem" anchos={[160, 320]} alt="" style={f.foco ? `object-position: ${f.foco}` : undefined} />
                    </button>
                  </li>
                ))}
              </ol>
              <button type="button" class="tira-paso" data-paso="1" aria-label={`Foto siguiente de ${h.conArticulo}`}>
                →
              </button>
              <span class="tira-contador" aria-live="polite">1 / {h.fotos.length}</span>
            </div>
          </div>
          <div class="hab-info">
            <h2 id={`${h.slug}-titulo`}>{h.nombre}</h2>
            <p class="hab-resumen">{h.entradilla}</p>
            <dl>
              <div>
                <dt>Superficie</dt>
                <dd>{h.metros} m²</dd>
              </div>
              <div>
                <dt>Huéspedes</dt>
                <dd>Hasta {h.huespedes}</dd>
              </div>
              <div>
                <dt>Desde</dt>
                <dd>{euros(h.precio)}</dd>
              </div>
            </dl>
            <ul class="servicios" aria-label="Servicios destacados">
              {h.servicios.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <p class="hab-diferencia">
              <b>En qué se diferencia:</b> {h.diferencia}
            </p>
            <div class="hab-acciones">
              <a class="boton boton-principal" href={ruta(`reservas?habitacion=${h.slug}`)} aria-label={`Elegir ${h.conArticulo} y preparar la estancia`}>
                Elegir esta habitación <span class="flecha" aria-hidden="true">→</span>
              </a>
              <a class="enlace" href={ruta(`habitaciones/${h.slug}`)}>
                Ver {h.conArticulo}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="comparador marco" aria-labelledby="comparar-titulo">
    <h2 id="comparar-titulo" data-revelar="titulo">Las cuatro, lado a lado</h2>
    <div class="comparador-tabla">
      <table>
        <caption class="solo-lector">Comparación de las cuatro habitaciones</caption>
        <thead>
          <tr>
            <th scope="col"><span class="solo-lector">Característica</span></th>
            {habitaciones.map((h, i) => <th scope="col" data-col={i}>{h.nombre}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            filas.map(([nombre, valor]) => (
              <tr>
                <th scope="row">{nombre}</th>
                {habitaciones.map((h, i) => (
                  <td data-col={i}>{valor(h)}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="incluido marco" aria-labelledby="incluido-titulo">
    <h2 id="incluido-titulo" data-revelar="titulo">Siempre incluido</h2>
    <dl data-revelar="grupo">
      {
        incluido.map(([t, d]) => (
          <div>
            <dt>{t}</dt>
            <dd>{d}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Pregunta arriba="¿Qué noche" abajo="te esperamos?" />
</Base>

<style>
  .cabeza {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(3.5rem, 1rem + 11vw, 11rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
  }

  .cabeza-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .entradilla {
    max-width: 38rem;
  }

  .cabeza-datos {
    color: var(--muted);
    font-size: var(--step-small);
  }

  /* — Sin JavaScript: una habitación tras otra — */
  .hab {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    scroll-margin-top: 6rem;
  }

  .hab + .hab {
    margin-top: var(--seccion);
  }

  .hab-foto {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .hab-escena {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--lino);
    touch-action: pan-y;
  }

  .hab-capa {
    position: absolute;
    inset: 0;
  }

  .hab-capa:not(.actual) {
    visibility: hidden;
  }

  .hab-capa :global(picture),
  .hab-capa :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hab-capa :global(img) {
    object-fit: cover;
  }

  /* Rótulo corto sobre la foto, con un velo neutro solo abajo */
  .hab-escena::after {
    content: "";
    position: absolute;
    inset: 55% 0 0;
    z-index: 3;
    background: linear-gradient(rgb(6 29 30 / 0), rgb(6 29 30 / 0.55)); /* taste-skill-ignore: velo neutro bajo texto sobre foto */
    pointer-events: none;
  }

  .hab-rotulo {
    position: absolute;
    left: 1.5rem;
    bottom: 1.25rem;
    z-index: 4;
    display: grid;
    gap: 0.3rem;
    color: var(--marfil);
  }

  .hab-rotulo-nombre {
    font: 380 var(--step-sub) / 1 var(--display);
  }

  .hab-rotulo-pie {
    font-size: var(--step-small);
    color: rgb(242 240 234 / 0.85);
  }

  .tira {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
  }

  .tira[hidden] {
    display: none;
  }

  .tira-fotos {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 3px;
    scrollbar-width: none;
  }

  .tira-fotos button {
    display: block;
    flex: none;
    width: 5rem;
    padding: 0;
    border: 0;
    border-radius: 0.35rem;
    overflow: hidden;
    background: var(--lino);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 300ms ease-out,
      box-shadow 300ms ease-out;
  }

  .tira-fotos button:hover {
    opacity: 0.85;
  }

  .tira-fotos button[aria-current="true"] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--teal);
  }

  .tira-fotos :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .tira-paso {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--piedra);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    font-size: 1.05rem;
    cursor: pointer;
  }

  .tira-paso:hover {
    border-color: var(--tinta);
  }

  .tira-contador {
    min-width: 3.5rem;
    text-align: right;
    font: 400 1.1rem / 1 var(--display);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .hab-info {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
    max-width: 32rem;
  }

  .hab-info h2 {
    font-size: var(--step-head);
  }

  .hab-resumen {
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  /* Tres datos en fila; en pantallas muy estrechas el tercero baja de línea */
  .hab-info dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(1.25rem, 4vw, 2rem);
  }

  dt {
    font: 600 var(--step-label) / 1.2 var(--text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0.35rem 0 0;
    font: 400 var(--step-sub) / 1 var(--display);
  }

  .servicios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .servicios li {
    padding: 0.45rem 0.85rem;
    border-radius: var(--radio);
    background: var(--lino);
    font-size: var(--step-small);
  }

  .hab-diferencia {
    color: var(--muted);
  }

  .hab-diferencia b {
    color: var(--ink);
    font-weight: 600;
  }

  .hab-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* — Con JavaScript: explorador — */
  .pestanas[hidden] {
    display: none;
  }

  .selector.es-selector {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: 2rem;
  }

  .es-selector .hab {
    display: contents;
  }

  .es-selector .hab-foto {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .es-selector .hab-info {
    grid-column: 2;
    grid-row: 2;
  }

  .es-selector .hab:not(.actual):not(.saliendo) .hab-foto,
  .es-selector .hab:not(.actual):not(.saliendo) .hab-info {
    visibility: hidden;
  }

  /* Las habitaciones ocupan la misma celda: la que sale queda debajo de la que entra */
  .es-selector .hab-foto,
  .es-selector .hab-info {
    grid-area: auto;
  }

  .es-selector .hab .hab-foto {
    grid-column: 1;
    grid-row: 1 / 3;
  }

  .es-selector .hab .hab-info {
    grid-column: 2;
    grid-row: 2;
  }

  .es-selector .hab:not(.actual) .hab-info {
    pointer-events: none;
  }

  .pestanas {
    grid-column: 2;
    grid-row: 1;
    display: grid;
  }

  [role="tab"] {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.75rem 0;
    border: 0;
    border-bottom: 1px solid var(--lino);
    background: none;
    color: var(--piedra);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 250ms ease-out;
  }

  .pestana-nombre {
    font: 400 var(--step-sub) / 1.1 var(--display);
  }

  .pestana-precio {
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
  }

  [role="tab"]:hover,
  [role="tab"][aria-selected="true"] {
    color: var(--ink);
  }

  [role="tab"]:focus-visible {
    outline: 2px solid var(--laton);
    outline-offset: 4px;
  }

  /* Comparador */
  .comparador {
    margin-top: var(--seccion);
  }

  .comparador h2 {
    font-size: var(--step-head);
    margin-bottom: 2rem;
  }

  .comparador-tabla {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: var(--step-small);
  }

  th,
  td {
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--lino);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    font: 400 1.15rem / 1.1 var(--display);
  }

  tbody th {
    width: 18%;
    color: var(--muted);
    font-weight: 500;
  }

  .resaltada {
    background: var(--blanco);
  }

  thead .resaltada {
    color: var(--teal);
  }

  .incluido {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 2rem clamp(2rem, 5vw, 6rem);
    margin-top: var(--seccion);
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--surface);
  }

  .incluido h2 {
    font-size: var(--step-head);
  }

  .incluido dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 4vw, 4rem);
  }

  .incluido dt {
    margin-bottom: 0.5rem;
    font: 400 var(--step-lead) / 1.2 var(--display);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }

  .incluido dd {
    margin: 0;
    font: inherit;
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .hab,
    .incluido,
    .incluido dl {
      grid-template-columns: 1fr;
    }

    .hab-escena {
      margin-inline: calc(-1 * var(--margen));
      aspect-ratio: 4 / 4.4;
    }

    .hab-rotulo {
      left: var(--margen);
    }

    .tira {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .tira-contador {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: left;
    }

    .tira-fotos button {
      width: 4rem;
    }

    /* En móvil: pestañas en una fila deslizable, foto y ficha debajo */
    .selector.es-selector {
      /* minmax(0, …): la tira de miniaturas no puede ensanchar la columna */
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      row-gap: 1.5rem;
    }

    .pestanas {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      gap: 1.25rem;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--margen));
      padding-inline: var(--margen);
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--margen);
      mask-image: linear-gradient(90deg, #000 82%, transparent);
    }

    .pestanas::-webkit-scrollbar {
      display: none;
    }

    [role="tab"] {
      flex: none;
      width: auto;
      flex-direction: column;
      gap: 0.2rem;
      border: 0;
      scroll-snap-align: start;
    }

    .es-selector .hab .hab-foto {
      grid-column: 1;
      grid-row: 2;
    }

    .es-selector .hab .hab-info {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>
