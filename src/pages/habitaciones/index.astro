---
// Habitaciones. Sin JavaScript, las cuatro se leen una tras otra. Con él,
// el selector (src/scripts/motion/habitaciones.ts) las convierte en pestañas:
// foto protagonista a la izquierda y ficha a la derecha, con su transición al
// cambiar. La foto de cada habitación comparte nombre de transición con la
// portada de su página: al entrar en ella, la foto viaja hasta allí.
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Pregunta from "../../components/Pregunta.astro";
import { habitaciones, totalLlaves, euros } from "../../data/habitaciones";
import { ruta } from "../../lib/ruta";

const desde = Math.min(...habitaciones.map((h) => h.precio));

const incluido = [
  ["Desayuno", "Hasta las doce, en la habitación, la terraza o la Mesa de Lumbre."],
  ["Termas", "Piscina de agua de mar templada, sauna de piedra y baño de vapor, de 8:00 a 21:00."],
  ["La poza", "Acceso por los 112 escalones a la poza de marea y a la cala de arena negra."],
  ["Traslado", "Desde el aeropuerto, incluido a partir de tres noches."],
  ["Hoja de la tarde", "Cada día, bajo la puerta: la hora del sol, las mareas y lo que hay en la lonja."],
  ["Silencio", "No hay televisores. Hay discos, libros y un ventanal al poniente."],
];
---

<Base title="Habitaciones" description="Veintidós llaves en cuatro formas de mirar el mar: estudios, suites y la Residencia Aurea.">
  <section class="cabeza marco" aria-labelledby="titulo" data-entrada>
    <h1 id="titulo">Habitaciones</h1>
    <div class="cabeza-fila">
      <p class="entradilla" data-entrada-paso>
        {totalLlaves} llaves en cuatro formas de mirar el mar. Todas con desayuno, termas y la misma puesta de sol delante.
      </p>
      <p class="cabeza-datos" data-entrada-paso>
        {habitaciones.length} categorías · desde {euros(desde)} la noche
      </p>
    </div>
  </section>

  <section class="selector marco" aria-label="Las cuatro habitaciones" data-escena="habitaciones">
    <div class="pestanas" role="tablist" aria-label="Elige una habitación" hidden>
      {
        habitaciones.map((h, i) => (
          <button
            type="button"
            role="tab"
            id={`pestana-${h.slug}`}
            aria-controls={h.slug}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-slug={h.slug}
          >
            <span class="pestana-nombre">{h.nombre}</span>
            <span class="pestana-precio">desde {euros(h.precio)}</span>
          </button>
        ))
      }
    </div>
    {
      habitaciones.map((h) => (
        <article id={h.slug} class="hab" data-slug={h.slug} aria-labelledby={`${h.slug}-titulo`}>
          <a class="hab-foto" href={ruta(`habitaciones/${h.slug}`)} tabindex="-1" aria-hidden="true">
            <Foto foto={h.fotos[0]} sizes="(min-width: 48rem) 56vw, 100vw" anchos={[640, 960, 1280, 1600, 2000]} transicion={`foto-${h.slug}`} />
          </a>
          <div class="hab-info">
            <h2 id={`${h.slug}-titulo`}>{h.nombre}</h2>
            <p class="hab-resumen">{h.resumen}</p>
            <dl>
              <div>
                <dt>Superficie</dt>
                <dd>{h.metros} m²</dd>
              </div>
              <div>
                <dt>Huéspedes</dt>
                <dd>Hasta {h.huespedes}</dd>
              </div>
              <div>
                <dt>Cama</dt>
                <dd>{h.cama}</dd>
              </div>
              <div>
                <dt>En la casa</dt>
                <dd>
                  {h.llaves} {h.llaves === 1 ? "llave" : "llaves"}
                </dd>
              </div>
            </dl>
            <p class="hab-precio">
              Desde <strong>{euros(h.precio)}</strong> la noche
            </p>
            <div class="hab-acciones">
              <a class="boton boton-principal" href={ruta(`reservas?habitacion=${h.slug}`)}>
                Reservar
              </a>
              <a class="enlace" href={ruta(`habitaciones/${h.slug}`)}>
                Ver {h.conArticulo}
              </a>
            </div>
            <div class="hab-miniaturas">
              <Foto foto={h.fotos[1]} sizes="(min-width: 48rem) 14vw, 44vw" anchos={[320, 480, 640]} />
              <Foto foto={h.fotos[2]} sizes="(min-width: 48rem) 14vw, 44vw" anchos={[320, 480, 640]} />
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="incluido marco" aria-labelledby="incluido-titulo">
    <h2 id="incluido-titulo" data-revelar="titulo">Siempre incluido</h2>
    <dl data-revelar="grupo">
      {
        incluido.map(([t, d]) => (
          <div>
            <dt>{t}</dt>
            <dd>{d}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Pregunta arriba="¿Qué noche" abajo="te esperamos?" />
</Base>

<style>
  .cabeza {
    padding-block: clamp(3rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  h1 {
    font-size: 15.5vw;
    line-height: 0.85;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .cabeza-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .entradilla {
    max-width: 32rem;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .cabeza-datos {
    color: var(--muted);
  }

  /* — Sin JavaScript: una habitación tras otra — */
  .hab {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
    scroll-margin-top: 2rem;
  }

  .hab + .hab {
    margin-top: var(--seccion);
  }

  .hab-foto {
    display: block;
    overflow: hidden;
  }

  .hab-foto :global(picture),
  .hab-foto :global(img) {
    display: block;
    width: 100%;
  }

  .hab-foto :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .hab-info {
    display: grid;
    gap: 1.4rem;
    align-content: start;
    justify-items: start;
    max-width: 32rem;
  }

  .hab-info h2 {
    font-size: var(--step-head);
  }

  .hab-resumen {
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .hab-info dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
    width: 100%;
  }

  dt {
    color: var(--muted);
    font-size: var(--step-small);
  }

  dd {
    margin: 0;
  }

  .hab-precio strong {
    font-family: var(--display);
    font-size: var(--step-lead);
    font-weight: 500;
  }

  .hab-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .hab-miniaturas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .hab-miniaturas :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  /* — Con JavaScript: selector de pestañas — */
  .pestanas[hidden] {
    display: none;
  }

  .selector.es-selector {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: auto 1fr;
    column-gap: clamp(2rem, 5vw, 6rem);
    row-gap: 2.5rem;
  }

  .es-selector .hab {
    display: contents;
  }

  /* La foto ocupa toda la altura de la columna derecha (pestañas y ficha) */
  .es-selector .hab-foto {
    grid-column: 1;
    grid-row: 1 / 3;
    position: relative;
    min-height: 34rem;
  }

  .es-selector .hab-foto :global(picture) {
    position: absolute;
    inset: 0;
  }

  .es-selector .hab-foto :global(img) {
    height: 100%;
    aspect-ratio: auto;
  }

  .es-selector .hab-info {
    grid-column: 2;
    grid-row: 2;
  }

  .es-selector .hab:not(.actual):not(.saliendo) .hab-foto,
  .es-selector .hab:not(.actual):not(.saliendo) .hab-info {
    visibility: hidden;
  }

  .es-selector .hab:not(.actual) .hab-info {
    pointer-events: none;
  }

  .pestanas {
    grid-column: 2;
    grid-row: 1;
    display: grid;
  }

  [role="tab"] {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.7rem 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 250ms ease-out;
  }

  .pestana-nombre {
    position: relative;
    font-family: var(--display);
    font-size: var(--step-lead);
    line-height: 1.1;
  }

  /* La pestaña elegida se marca con su color y un subrayado dorado que crece */
  .pestana-nombre::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2em;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pestana-precio {
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
  }

  [role="tab"]:hover,
  [role="tab"][aria-selected="true"] {
    color: var(--ink);
  }

  [role="tab"][aria-selected="true"] .pestana-nombre::after {
    transform: scaleX(1);
  }

  [role="tab"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .incluido {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 2rem clamp(2rem, 5vw, 6rem);
    margin-top: var(--seccion);
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--surface);
  }

  .incluido h2 {
    font-size: var(--step-head);
  }

  .incluido dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem clamp(2rem, 4vw, 4rem);
  }

  .incluido dt {
    font-family: var(--display);
    font-size: var(--step-lead);
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    h1 {
      font-size: 15vw;
    }

    .hab,
    .incluido,
    .incluido dl {
      grid-template-columns: 1fr;
    }

    .hab-foto {
      margin-inline: calc(-1 * var(--margen));
    }

    /* En móvil: pestañas en una fila que se desliza, foto y ficha debajo */
    .selector.es-selector {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 1.5rem;
    }

    .pestanas {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--margen));
      padding-inline: var(--margen);
    }

    .pestanas::-webkit-scrollbar {
      display: none;
    }

    [role="tab"] {
      flex: none;
      width: auto;
      flex-direction: column;
      gap: 0.25rem;
    }

    .es-selector .hab-foto {
      grid-column: 1;
      grid-row: 2;
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .es-selector .hab-info {
      grid-column: 1;
      grid-row: 3;
    }
  }
</style>
