---
// El pie es la última fotografía: enlaces y contacto arriba, el nombre a todo
// lo ancho abajo y una línea legal debajo, con la preferencia de movimiento
// plegada (se despliega al pedirla).
// Movimiento: src/scripts/motion/pie.ts. Control: src/scripts/control-movimiento.ts
import Foto from "./Foto.astro";
import { navegacion, reservas } from "../data/navegacion";
import { sitio } from "../data/sitio";
import type { ClaveFoto } from "../data/fotos";
import { ruta } from "../lib/ruta";

interface Props {
  foto?: ClaveFoto;
}

const { foto = "costaBarca" } = Astro.props;
const opcionesMovimiento = [
  { valor: "auto", texto: "Automático" },
  { valor: "completo", texto: "Completo" },
  { valor: "reducido", texto: "Reducido" },
];
---

<footer class="pie noche" data-escena="pie">
  <Foto foto={foto} sizes="100vw" class="pie-foto" alt="" />
  <div class="pie-capa marco">
    <div class="pie-fila">
      <nav aria-label="Pie">
        <ul>
          {navegacion.map(({ destino, texto }) => <li><a href={ruta(destino)}>{texto}</a></li>)}
          <li><a href={ruta(reservas.destino)}>{reservas.texto}</a></li>
          <li><a href={ruta("creditos")}>Créditos</a></li>
        </ul>
      </nav>
      <address>
        {sitio.direccion.map((l) => <span>{l}</span>)}
        <a href={`tel:${sitio.telefono.replace(/\s/g, "")}`}>{sitio.telefono}</a>
        <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>
      </address>
    </div>
    <div class="pie-cierre">
      <p class="pie-nombre" aria-hidden="true">Aurea</p>
      <p class="pie-demo">
        Aurea es un hotel ficticio: esta web es una demo de diseño y desarrollo. Sus fotografías son referencias visuales de Unsplash y Pexels,
        con sus autores en <a href={ruta("creditos")}>créditos</a>; los precios y la reserva son de demostración.
      </p>
      <details class="preferencias">
        <summary>Movimiento: <span data-movimiento-actual>Automático</span></summary>
        <fieldset class="movimiento">
          <legend class="solo-lector">Movimiento de la página</legend>
          <div class="movimiento-opciones">
            {
              opcionesMovimiento.map((o) => (
                <label>
                  <input type="radio" name="movimiento" value={o.valor} checked={o.valor === "auto"} />
                  <span>{o.texto}</span>
                </label>
              ))
            }
          </div>
          <p class="movimiento-nota" data-movimiento-nota aria-live="polite">Automático sigue el ajuste de tu sistema.</p>
        </fieldset>
      </details>
    </div>
  </div>
</footer>

<script>
  import "../scripts/control-movimiento";
</script>

<style>
  .pie {
    position: relative;
    display: grid;
    min-height: 100svh;
    margin-top: var(--seccion);
    color: var(--ink);
    overflow: hidden;
  }

  /* Tras la pregunta final, el pie empieza pegado: los dos son campos a sangre */
  :global(main:has(> .pregunta:last-child)) + .pie {
    margin-top: 0;
  }

  .pie > :global(picture),
  .pie-capa {
    grid-area: 1 / 1;
  }

  .pie :global(.pie-foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.55) saturate(0.85);
  }

  .pie-capa {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 2rem 1.5rem;
  }

  .pie-fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 2rem;
  }

  ul {
    display: grid;
    gap: 0.25rem;
  }

  a {
    text-decoration: none;
  }

  /* Subrayado dorado que se dibuja al pasar */
  nav a,
  address a {
    background: linear-gradient(var(--laton-claro), var(--laton-claro)) no-repeat 0 100% / 0 1px; /* taste-skill-ignore: subrayado, no un degradado */
    transition: background-size 300ms ease-out;
  }

  nav a:hover,
  nav a:focus-visible,
  address a:hover,
  address a:focus-visible {
    background-size: 100% 1px;
  }

  nav a {
    display: inline-block;
    padding-block: 0.25rem;
  }

  address {
    display: grid;
    align-content: start;
    justify-items: end;
    gap: 0.25rem;
    font-style: normal;
    text-align: right;
  }

  /* Preferencia de movimiento: una línea discreta junto al aviso legal que
     se despliega al pedirla (details nativo: teclado y lector de pantalla) */
  .preferencias {
    margin-top: 0.5rem;
    font-size: var(--step-small);
  }

  .preferencias summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: rgb(242 240 234 / 0.75);
    list-style: none;
    cursor: pointer;
  }

  .preferencias summary::-webkit-details-marker {
    display: none;
  }

  .preferencias summary::after {
    content: "+";
    color: var(--laton-claro);
  }

  .preferencias[open] summary::after {
    content: "−";
  }

  .preferencias summary:hover,
  .preferencias summary:focus-visible {
    color: var(--marfil);
  }

  .preferencias summary:focus-visible {
    outline: 2px solid var(--laton-claro);
    outline-offset: 2px;
  }

  .preferencias summary span {
    color: var(--marfil);
  }

  .movimiento {
    display: grid;
    justify-items: start;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .movimiento-opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .movimiento label {
    position: relative;
    cursor: pointer;
  }

  .movimiento input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .movimiento span {
    display: block;
    padding-block: 0.7rem;
    color: rgb(242 240 234 / 0.75);
    background: linear-gradient(var(--laton-claro), var(--laton-claro)) no-repeat 0 calc(100% - 0.45rem) / 0 1px; /* taste-skill-ignore: subrayado, no un degradado */
    transition:
      color 200ms ease-out,
      background-size 300ms ease-out;
  }

  .movimiento label:hover span {
    color: var(--marfil);
  }

  .movimiento input:checked + span {
    color: var(--marfil);
    background-size: 100% 1px;
  }

  .movimiento input:focus-visible + span {
    outline: 2px solid var(--laton-claro);
    outline-offset: 2px;
  }

  .movimiento-nota {
    color: rgb(242 240 234 / 0.75);
  }

  .pie-nombre {
    font-family: var(--display);
    font-weight: 340;
    font-size: 30vw;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .pie-demo {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: var(--step-small);
  }

  .pie-demo a {
    text-decoration: underline;
  }

  @media (max-width: 47.99rem) {
    .pie {
      min-height: 88svh;
    }

    .pie-fila {
      grid-template-columns: 1fr;
    }

    address {
      justify-items: start;
      text-align: left;
    }

    .pie-nombre {
      font-size: 34vw;
    }
  }
</style>
