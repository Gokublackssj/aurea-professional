---
// El pie es la última fotografía: enlaces, el control de movimiento y el
// contacto arriba, el nombre a todo lo ancho abajo y una línea legal debajo.
// Movimiento: src/scripts/motion/pie.ts. Control: src/scripts/control-movimiento.ts
import Foto from "./Foto.astro";
import { navegacion, reservas } from "../data/navegacion";
import { sitio } from "../data/sitio";
import type { ClaveFoto } from "../data/fotos";
import { ruta } from "../lib/ruta";

interface Props {
  foto?: ClaveFoto;
}

const { foto = "costaBarca" } = Astro.props;
const opcionesMovimiento = [
  { valor: "auto", texto: "Automático" },
  { valor: "completo", texto: "Completo" },
  { valor: "reducido", texto: "Reducido" },
];
---

<footer class="pie" data-escena="pie">
  <Foto foto={foto} sizes="100vw" class="pie-foto" alt="" />
  <div class="pie-capa marco">
    <div class="pie-fila">
      <nav aria-label="Pie">
        <ul>
          {navegacion.map(({ destino, texto }) => <li><a href={ruta(destino)}>{texto}</a></li>)}
          <li><a href={ruta(reservas.destino)}>{reservas.texto}</a></li>
          <li><a href={ruta("creditos")}>Créditos</a></li>
        </ul>
      </nav>
      <fieldset class="movimiento">
        <legend>Movimiento</legend>
        <div class="movimiento-opciones">
          {
            opcionesMovimiento.map((o) => (
              <label>
                <input type="radio" name="movimiento" value={o.valor} checked={o.valor === "auto"} />
                <span>{o.texto}</span>
              </label>
            ))
          }
        </div>
        <p class="movimiento-nota" data-movimiento-nota aria-live="polite">Automático sigue el ajuste de tu sistema.</p>
      </fieldset>
      <address>
        {sitio.direccion.map((l) => <span>{l}</span>)}
        <a href={`tel:${sitio.telefono.replace(/\s/g, "")}`}>{sitio.telefono}</a>
        <a href={`mailto:${sitio.correo}`}>{sitio.correo}</a>
      </address>
    </div>
    <div class="pie-cierre">
      <p class="pie-nombre" aria-hidden="true">Aurea</p>
      <p class="pie-demo">
        Aurea es un hotel ficticio: esta web es una demo de diseño y desarrollo, y sus fotografías son referencias visuales de Unsplash, con sus
        autores en <a href={ruta("creditos")}>créditos</a>.
      </p>
    </div>
  </div>
</footer>

<script>
  import "../scripts/control-movimiento";
</script>

<style>
  .pie {
    position: relative;
    display: grid;
    min-height: 100svh;
    margin-top: var(--seccion);
    color: var(--ink);
    overflow: hidden;
  }

  /* Tras la pregunta final, el pie empieza pegado: los dos son campos a sangre */
  :global(main:has(> .pregunta:last-child)) + .pie {
    margin-top: 0;
  }

  .pie > :global(picture),
  .pie-capa {
    grid-area: 1 / 1;
  }

  .pie :global(.pie-foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.62);
  }

  .pie-capa {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 2rem 1.5rem;
  }

  .pie-fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 2rem;
  }

  ul {
    display: grid;
    gap: 0.25rem;
  }

  a {
    text-decoration: none;
  }

  /* Subrayado dorado que se dibuja al pasar */
  nav a,
  address a {
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100% / 0 1px; /* taste-skill-ignore: subrayado, no un degradado */
    transition: background-size 300ms ease-out;
  }

  nav a:hover,
  nav a:focus-visible,
  address a:hover,
  address a:focus-visible {
    background-size: 100% 1px;
  }

  nav a {
    display: inline-block;
    padding-block: 0.25rem;
  }

  address {
    display: grid;
    align-content: start;
    justify-items: end;
    gap: 0.25rem;
    font-style: normal;
    text-align: right;
  }

  /* Control de movimiento: tres opciones en una pastilla de texto */
  .movimiento {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.6rem;
    font-size: var(--step-small);
  }

  .movimiento-opciones {
    display: flex;
    background: rgb(16 14 12 / 0.6);
  }

  .movimiento label {
    position: relative;
    cursor: pointer;
  }

  .movimiento input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .movimiento span {
    display: block;
    padding: 0.6rem 0.95rem;
    font-size: var(--step-small);
    transition:
      background-color 200ms ease-out,
      color 200ms ease-out;
  }

  .movimiento label:hover span {
    background: rgb(235 232 226 / 0.12);
  }

  .movimiento input:checked + span {
    background: var(--ink);
    color: var(--bg);
  }

  .movimiento input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .movimiento-nota {
    font-size: var(--step-small);
  }

  .pie-nombre {
    font-family: var(--display);
    font-weight: 500;
    font-size: 35vw;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .pie-demo {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: var(--step-small);
  }

  .pie-demo a {
    text-decoration: underline;
  }

  @media (max-width: 63.99rem) {
    .pie-fila {
      grid-template-columns: 1fr 1fr;
    }

    .movimiento {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-items: start;
    }
  }

  @media (max-width: 47.99rem) {
    .pie {
      min-height: 88svh;
    }

    .pie-fila {
      grid-template-columns: 1fr;
    }

    .movimiento {
      grid-row: auto;
    }

    address {
      justify-items: start;
      text-align: left;
    }

    .pie-nombre {
      font-size: 34vw;
    }
  }
</style>
