---
// El nombre bajo la fotografía: la foto ocupa la parte alta de la pantalla y
// «Aurea», a todo lo ancho, cierra la parte baja. El nombre es el logotipo.
// Movimiento: src/scripts/motion/hero.ts
import Foto from "../Foto.astro";
import { ruta } from "../../lib/ruta";
---

<section class="hero" aria-labelledby="hero-titulo" data-escena="hero">
  <div class="hero-foto">
    <Foto foto="costaAcantilado" sizes="100vw" prioridad anchos={[640, 960, 1280, 1600, 1920, 2400]} />
    <div class="hero-velo" aria-hidden="true"></div>
  </div>
  <div class="hero-banda marco">
    <span class="hero-linea" aria-hidden="true"></span>
    <div class="hero-fila">
      <p class="hero-frase">Hotel de veintidós llaves sobre un cabo de basalto, frente al poniente del Atlántico.</p>
      <a class="boton boton-principal" href={ruta("reservas")}>Reservar estancia</a>
    </div>
    <h1 id="hero-titulo" class="hero-nombre"><span class="hero-nombre-texto">Aurea</span><span class="solo-lector">, hotel en Cabo Lumbre</span></h1>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-rows: 46svh auto;
    min-height: 100svh;
    overflow: hidden;
  }

  .hero-foto {
    position: relative;
    overflow: hidden;
  }

  .hero-foto :global(picture),
  .hero-foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-foto :global(img) {
    object-fit: cover;
    object-position: 50% 28%;
  }

  .hero-velo {
    position: absolute;
    inset: 0;
    background: #050403;
    opacity: 0;
    pointer-events: none;
  }

  .hero-banda {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
  }

  /* La línea dorada que separa la foto del nombre */
  .hero-linea {
    position: absolute;
    top: 0;
    left: var(--margen);
    right: var(--margen);
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .hero-fila {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero-frase {
    max-width: 30rem;
    font-size: var(--step-body);
  }

  .hero-nombre {
    font-size: min(35vw, 50svh);
    /* La A de Bodoni vuela a la izquierda de su caja: se compensa para que el
       nombre arranque en el margen como el resto de la página */
    padding-left: 0.05em;
    line-height: 0.8;
    letter-spacing: -0.05em;
    white-space: nowrap;
    /* El trazo inferior casi toca el borde de la pantalla */
    margin-bottom: -0.02em;
  }

  /* Antes del primer pintado, con movimiento permitido: la foto empieza en una
     franja (que ya se pinta: es la imagen principal) y el resto espera a GSAP.
     Si el motor no arranca, el script de la cabecera quita «motion» a los 4 s. */
  :global(html.motion) .hero-foto {
    clip-path: inset(44% 9% 44% 9%);
  }

  :global(html.motion) .hero-nombre,
  :global(html.motion) .hero-fila,
  :global(html.motion) .cabecera.sobre-foto {
    visibility: hidden;
  }

  :global(html.motion) .hero-linea {
    transform: scaleX(0);
  }

  @media (max-width: 47.99rem) {
    .hero {
      grid-template-rows: 50svh auto;
    }

    .hero-fila {
      flex-direction: column;
    }

    .hero-nombre {
      font-size: 31vw;
      padding-bottom: 0.75rem;
    }

    :global(html.motion) .hero-foto {
      clip-path: inset(40% 6% 40% 6%);
    }
  }
</style>
