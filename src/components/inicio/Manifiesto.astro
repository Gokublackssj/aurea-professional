---
// El cabo en una frase: la tinta avanza palabra a palabra con el scroll. A la
// derecha, los dos materiales que nombra (basalto y cal) en dos arcos; debajo,
// tres cifras del lugar. Movimiento: src/scripts/motion/manifiesto.ts.
import Foto from "../Foto.astro";
import { sitio } from "../../data/sitio";
import { totalLlaves } from "../../data/habitaciones";

const cifras = [
  [sitio.alturaSobreElMar, "metros sobre el Atlántico"],
  [sitio.escalones, "escalones hasta la cala"],
  [totalLlaves, "habitaciones en toda la casa"],
] as const;
---

<section class="manifiesto marco" aria-labelledby="manifiesto-titulo" data-escena="manifiesto">
  <div class="manifiesto-texto">
    <h2 id="manifiesto-titulo" class="etiqueta">El cabo</h2>
    <p class="frase">Aquí el día se mide por la luz: basalto al alba, cal a mediodía y oro cuando el sol se pone sobre el mar.</p>
  </div>
  <div class="arcos">
    <figure class="arco">
      <Foto foto="materialBasalto" sizes="(min-width: 48rem) 20vw, 46vw" anchos={[320, 480, 640, 800]} />
    </figure>
    <figure class="arco">
      <Foto foto="materialCal" sizes="(min-width: 48rem) 20vw, 46vw" anchos={[320, 480, 640, 800]} />
    </figure>
  </div>
  <dl class="cifras">
    {
      cifras.map(([n, texto]) => (
        <div class="cifra">
          <dt>{texto}</dt>
          <dd data-contar={n}>{n}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .manifiesto {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3rem 6vw;
    align-items: center;
    padding-block: var(--seccion);
  }

  .manifiesto-texto {
    display: grid;
    gap: 2rem;
  }

  .frase {
    font: 380 clamp(1.75rem, 1rem + 2.6vw, 3.4rem) / 1.12 var(--display);
    letter-spacing: -0.015em;
  }

  /* Con el motor, las palabras empiezan apagadas y pasan a tinta. El tono de
     partida cumple 3:1 sobre marfil (AA para texto grande): se lee siempre. */
  .frase :global(.palabra) {
    color: #8a8478;
  }

  .arcos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: end;
  }

  .arco {
    overflow: hidden;
    border-radius: 999px 999px 0 0;
  }

  .arco :global(picture),
  .arco :global(img) {
    display: block;
    width: 100%;
  }

  .arco :global(img) {
    aspect-ratio: 3 / 5;
    object-fit: cover;
  }

  .arco:nth-child(2) {
    margin-bottom: 4rem;
  }

  .cifras {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--linea);
  }

  .cifra {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .cifra dd {
    margin: 0;
    font: 340 clamp(2.5rem, 1.5rem + 3vw, 4.5rem) / 1 var(--display);
    font-variant-numeric: tabular-nums;
  }

  .cifra dt {
    color: var(--muted);
    font-size: var(--step-small);
  }

  @media (max-width: 47.99rem) {
    .manifiesto {
      grid-template-columns: 1fr;
    }

    .cifras {
      gap: 1rem;
    }

    .cifra dd {
      font-size: 2.25rem;
    }

    .arco:nth-child(2) {
      margin-bottom: 2rem;
    }
  }
</style>
