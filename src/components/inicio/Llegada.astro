---
// El camino hasta Aurea, en formato cine: una banda panorámica que se abre en
// vertical hasta ocupar la pantalla. Movimiento: src/scripts/motion/llegada.ts.
// Escritorio con movimiento: el escenario es sticky (CSS) dentro de una sección
// de 2,1 pantallas; título y texto ceden la pantalla a la foto y aparece la
// frase final. Móvil: título, foto que se abre y texto debajo, sin fijar.
// Modo reducido: la banda en su primer fotograma, con todo el texto.
import Foto from "../Foto.astro";
---

<section class="llegada" aria-labelledby="llegada-titulo" data-escena="llegada">
  <div class="llegada-escena">
    <div class="llegada-foto">
      <Foto foto="llegadaCosta" sizes="100vw" anchos={[960, 1280, 1600, 2000]} />
      <div class="llegada-velo" aria-hidden="true"></div>
    </div>
    <div class="llegada-cabeza marco">
      <h2 id="llegada-titulo" class="titulo">El camino hasta Aurea</h2>
      <span class="etiqueta">50 minutos desde el aeropuerto</span>
    </div>
    <div class="llegada-pie marco">
      <p>La carretera de la costa termina en un portón de madera. El último kilómetro es una pista de picón negro entre tabaibas.</p>
      <span class="etiqueta">Traslado incluido desde 3 noches</span>
    </div>
    <p class="llegada-frase titulo marco" aria-hidden="true">Donde termina el camino, empieza el mar.</p>
  </div>
</section>

<style>
  .llegada {
    position: relative;
  }

  .llegada-escena {
    position: relative;
    height: 100svh;
    overflow: hidden;
  }

  .llegada-foto {
    position: absolute;
    inset: 0;
    clip-path: inset(29% 0% 29% 0%);
  }

  .llegada-foto :global(picture),
  .llegada-foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .llegada-foto :global(img) {
    object-fit: cover;
  }

  .llegada-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 29 30 / 0) 40%, rgb(6 29 30 / 0.65)); /* taste-skill-ignore: velo neutro bajo texto sobre foto */
    opacity: 0;
  }

  .llegada-cabeza {
    position: absolute;
    top: 9vh;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }

  .llegada-pie {
    position: absolute;
    bottom: 9vh;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .llegada-pie p {
    max-width: 30rem;
    color: var(--muted);
  }

  .llegada-frase {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12vh;
    color: var(--marfil);
    opacity: 0;
  }

  /* Escritorio con movimiento completo: escenario sticky. La altura de la
     sección es el recorrido (100svh + lo que dura la escena). */
  @media (min-width: 48rem) {
    :global(html[data-movimiento="completo"]) .llegada {
      height: 210svh;
    }

    :global(html[data-movimiento="completo"]) .llegada-escena {
      position: sticky;
      top: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .llegada-escena {
      height: auto;
      display: grid;
      gap: 1.5rem;
      padding-top: 4rem;
    }

    .llegada-cabeza,
    .llegada-pie {
      position: static;
      flex-direction: column;
      align-items: start;
      gap: 0.5rem;
    }

    .llegada-cabeza {
      order: -1;
    }

    .llegada-foto {
      position: relative;
      aspect-ratio: 4 / 5;
      clip-path: inset(30% 0% 30% 0%);
    }

    .llegada-frase,
    .llegada-velo {
      display: none;
    }
  }
</style>
