---
// Un día en Aurea: cinco momentos, de la poza de las 7:30 al cielo de las 21:30.
// Escritorio con movimiento: escenario sticky (CSS) de tres pantallas, media
// por momento; el reloj rueda, el fondo de cada momento se abre de abajo arriba
// y las barras de progreso llevan a cada momento. Sin ajuste automático: la
// página nunca se mueve sola. Movimiento: src/scripts/motion/dia.ts.
// Móvil y modo reducido: los cinco momentos en bloques normales, con un reloj
// pequeño fijo en la cabecera de la sección.
// La hora áurea y la luna se calculan para hoy en el cabo (src/scripts/hoja.ts);
// sin JavaScript quedan la hora y la frase generales.
import Foto from "../Foto.astro";
import type { ClaveFoto } from "../../data/fotos";

interface Momento {
  hora: string;
  titulo: string;
  texto: string;
  fondo: ClaveFoto;
  secundarias: [ClaveFoto, ClaveFoto];
  vivo?: "sol" | "luna";
}

// Cada momento: un fondo y dos fotos de esa misma luz. Ninguna se repite en
// otra sección del inicio.
const momentos: Momento[] = [
  {
    hora: "07:30",
    titulo: "La poza de marea",
    texto: "Al pie de los escalones, la marea llena una poza tallada en la roca. Agua quieta a veinte grados, antes que nadie.",
    fondo: "diaPoza",
    secundarias: ["diaOrilla", "diaRocas"],
  },
  {
    hora: "09:00",
    titulo: "Desayuno sin reloj",
    texto: "De nueve a doce, en la habitación o en la terraza: pan de leña, queso de cabra de la ladera y fruta del valle.",
    fondo: "miradorVentana",
    secundarias: ["diaDesayuno", "estudioLuz"],
  },
  {
    hora: "13:30",
    titulo: "La mesa frente al mar",
    texto: "Lo que entró por la mañana en la lonja del puerto, servido al aire libre con limones del valle.",
    fondo: "diaMediodia",
    secundarias: ["mesaPescado", "mesaLimones"],
  },
  {
    hora: "19:40",
    titulo: "La hora áurea",
    texto: "El sol se pone delante de la terraza. Se sirve una copa y la casa baja las luces.",
    fondo: "diaAzotea",
    secundarias: ["diaCopa", "diaVentanaOcaso"],
    vivo: "sol",
  },
  {
    hora: "21:30",
    titulo: "El cielo desde la azotea",
    texto: "Sin una farola en nueve kilómetros. Arriba espera un telescopio y alguien que sabe dónde mirar.",
    fondo: "expEstrellas",
    secundarias: ["nochePozaEstrellas", "nocheFarol"],
    vivo: "luna",
  },
];

// Dígitos de «HH:MM» por posición, para el reloj que rueda
const posiciones = [0, 1, 3, 4];
---

<section class="dia noche" aria-labelledby="dia-titulo" data-escena="dia">
  <div class="dia-escena">
    <div class="dia-texto">
      <h2 id="dia-titulo" class="etiqueta">Un día en Aurea</h2>
      <div class="reloj" aria-hidden="true">
        {
          posiciones.map((p, k) => (
            <>
              {k === 2 && <span class="dos-puntos">:</span>}
              <span class="rueda">
                {momentos.map((m) => (
                  <span data-hoja-digito={m.vivo === "sol" ? p : undefined}>{m.hora[p]}</span>
                ))}
              </span>
            </>
          ))
        }
      </div>
      <div class="dia-momentos">
        {
          momentos.map((m) => (
            <div class="dia-momento">
              <h3 class="titulo">
                <span class="solo-lector">
                  <span data-hoja-hora={m.vivo === "sol" ? "aurea" : undefined}>{m.hora}</span>.{" "}
                </span>
                {m.titulo}
              </h3>
              <p data-hoja={m.vivo}>{m.texto}</p>
            </div>
          ))
        }
      </div>
      <div class="dia-progreso" role="group" aria-label="Ir a un momento del día">
        {
          momentos.map((m, i) => (
            <button type="button" data-i={i} aria-label={`Ir a ${m.titulo}`}>
              <i></i>
            </button>
          ))
        }
      </div>
    </div>
    <div class="dia-fotos" aria-hidden="true">
      {
        momentos.map((m) => (
          <figure class="dia-foto">
            <Foto foto={m.fondo} sizes="(min-width: 48rem) 60vw, 100vw" anchos={[800, 1200, 1600]} alt="" />
            <div class="secundarias">
              {m.secundarias.map((s) => (
                <Foto foto={s} sizes="9rem" anchos={[160, 320]} alt="" />
              ))}
            </div>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="dia-lista">
    <div class="dia-cabecera" aria-hidden="true">
      <span class="etiqueta">Un día en Aurea</span>
      <span class="dia-hora">{momentos[0].hora}</span>
    </div>
    {
      momentos.map((m) => (
        <article class="dia-bloque" data-hora={m.hora} data-hoja-bloque={m.vivo === "sol" ? "aurea" : undefined}>
          <div class="dia-bloque-foto">
            <Foto foto={m.fondo} sizes="(min-width: 48rem) 55vw, 100vw" anchos={[480, 800, 1200]} />
          </div>
          <div class="dia-bloque-texto">
            <span class="dia-bloque-hora" data-hoja-hora={m.vivo === "sol" ? "aurea" : undefined}>
              {m.hora}
            </span>
            <h3 class="titulo">{m.titulo}</h3>
            <p data-hoja={m.vivo}>{m.texto}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import "../../scripts/hoja";
</script>

<style>
  .dia {
    position: relative;
    margin-top: var(--seccion);
  }

  /* — Escena de escritorio — */
  .dia-escena {
    position: relative;
    display: grid;
    grid-template-columns: 5fr 7fr;
    height: 100svh;
    overflow: hidden;
  }

  .dia-texto {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    gap: 1.75rem;
    padding: 6rem var(--margen);
  }

  .reloj {
    display: flex;
    align-items: flex-start;
    height: 1em;
    overflow: hidden;
    font: 300 clamp(4rem, 2rem + 6vw, 8rem) / 1 var(--display);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }

  .rueda {
    display: block;
  }

  .rueda span {
    display: block;
    height: 1em;
  }

  .dos-puntos {
    opacity: 0.6;
  }

  .dia-momentos {
    display: grid;
  }

  .dia-momento {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .dia-momento p {
    max-width: 28rem;
    color: var(--muted);
  }

  .dia-progreso {
    display: flex;
    gap: 0.25rem;
  }

  .dia-progreso button {
    padding: 1rem 0.15rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dia-progreso i {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 2px;
    overflow: hidden;
    background: rgb(242 240 234 / 0.2);
    transition: height 200ms ease-out;
  }

  .dia-progreso button:hover i {
    height: 4px;
  }

  .dia-progreso i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--laton-claro);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .dia-fotos {
    position: relative;
    overflow: hidden;
  }

  .dia-foto {
    position: absolute;
    inset: 0;
  }

  .dia-foto > :global(picture),
  .dia-foto > :global(picture) :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dia-foto > :global(picture) :global(img) {
    object-fit: cover;
  }

  .secundarias {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    display: flex;
    gap: 0.75rem;
  }

  .secundarias :global(img) {
    width: 8.5rem;
    aspect-ratio: 4 / 5;
    height: auto;
    object-fit: cover;
    border: 3px solid var(--noche);
  }

  /* Escritorio con movimiento completo: escenario sticky de tres pantallas */
  @media (min-width: 48rem) {
    :global(html[data-movimiento="completo"]) .dia {
      height: 300svh;
    }

    :global(html[data-movimiento="completo"]) .dia-escena {
      position: sticky;
      top: 0;
    }

    :global(html[data-movimiento="completo"]) .dia-lista {
      display: none;
    }

    /* Sin el motor, solo el primer momento a la vista en la escena */
    :global(html[data-movimiento="completo"]) .dia-momento:not(:first-child) {
      opacity: 0;
    }
  }

  /* Móvil, modo reducido y sin JavaScript: bloques normales */
  @media (max-width: 47.99rem) {
    .dia-escena {
      display: none;
    }
  }

  :global(html[data-movimiento="reducido"]) .dia-escena,
  :global(html:not(.js)) .dia-escena {
    display: none;
  }

  :global(html:not(.js)) .dia-lista {
    display: block;
  }

  .dia-lista {
    padding-bottom: var(--seccion);
  }

  .dia-cabecera {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem var(--margen);
    background: rgb(6 29 30 / 0.94);
    border-bottom: 1px solid rgb(242 240 234 / 0.12);
  }

  .dia-hora {
    display: inline-block;
    font: 300 1.9rem / 1 var(--display);
    font-variant-numeric: tabular-nums;
  }

  .dia-bloque {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 2rem 4vw;
    align-items: center;
    padding: clamp(2.5rem, 6vw, 5rem) var(--margen) 0;
  }

  .dia-bloque-foto {
    overflow: hidden;
  }

  .dia-bloque-foto :global(picture),
  .dia-bloque-foto :global(img) {
    display: block;
    width: 100%;
  }

  .dia-bloque-foto :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .dia-bloque-texto {
    display: grid;
    gap: 0.75rem;
  }

  .dia-bloque-hora {
    font: 300 clamp(2.5rem, 1.5rem + 3vw, 4rem) / 1 var(--display);
    color: var(--laton-claro);
    font-variant-numeric: tabular-nums;
  }

  .dia-bloque-texto p {
    max-width: 28rem;
    color: var(--muted);
  }

  @media (max-width: 47.99rem) {
    .dia-bloque {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .dia-bloque-foto {
      margin-inline: calc(-1 * var(--margen));
    }

    .dia-bloque-foto :global(img) {
      aspect-ratio: 4 / 4.4;
    }
  }
</style>
