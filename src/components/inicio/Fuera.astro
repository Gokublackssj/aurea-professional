---
// Fotografías reunidas alrededor de un título: lo que hay fuera de la
// habitación. Es el único descanso deliberado de la página. Son fotos de las
// experiencias (termas, cala, kayak, viñas, barca) que no aparecen en ninguna
// otra sección del inicio.
// Movimiento (src/scripts/motion/fuera.ts): se abren al llegar y cada una
// flota a su ritmo (data-velocidad) con el scroll.
import Foto from "../Foto.astro";
import type { ClaveFoto } from "../../data/fotos";
import { ruta } from "../../lib/ruta";

// Posición en porcentaje de la banda (x, y), ancho en px y velocidad de
// flotación. Las marcadas con `movil` son las que se quedan en pantallas estrechas.
const fotosBanda: { foto: ClaveFoto; x: number; y: number; ancho: number; velocidad: number; movil?: boolean }[] = [
  { foto: "spaPiscina", x: 22, y: 5, ancho: 210, velocidad: 0.18, movil: true },
  { foto: "costaPlayaNegra", x: 45, y: 0, ancho: 170, velocidad: 0.3 },
  { foto: "expKayak", x: 64, y: 8, ancho: 190, velocidad: 0.12, movil: true },
  { foto: "spaTumbonas", x: 19, y: 62, ancho: 175, velocidad: 0.26, movil: true },
  { foto: "expVina", x: 41, y: 76, ancho: 200, velocidad: 0.1, movil: true },
  { foto: "expBarca", x: 66, y: 58, ancho: 180, velocidad: 0.22, movil: true },
];
---

<section class="fuera" aria-labelledby="fuera-titulo" data-escena="fuera">
  <div class="fuera-centro">
    <h2 id="fuera-titulo" data-revelar="titulo">Agua, mesa,<br />mar y cielo</h2>
    <p data-revelar="texto">Termas de agua de mar, la Mesa de Lumbre, kayak hasta la cueva, vinos de ceniza y una cala de arena negra.</p>
    <a class="boton boton-principal" href={ruta("experiencias")} data-revelar="texto">Descubrir las experiencias <span class="flecha" aria-hidden="true">→</span></a>
  </div>
  {
    fotosBanda.map((f) => (
      <div
        class:list={["suelta", { "solo-escritorio": !f.movil }]}
        style={`--x:${f.x}%;--y:${f.y}%;--ancho:${f.ancho}px`}
        data-velocidad={f.velocidad}
      >
        <Foto foto={f.foto} sizes={`${f.ancho}px`} anchos={[f.ancho, f.ancho * 2]} />
      </div>
    ))
  }
</section>

<style>
  .fuera {
    position: relative;
    min-height: 100svh;
    margin-top: var(--seccion);
    margin-inline: var(--margen);
  }

  .fuera-centro {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(28rem, 100%);
    transform: translate(-50%, -50%);
    text-align: center;
  }

  h2 {
    font-size: var(--step-head);
    line-height: 1;
  }

  .suelta {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--ancho);
  }

  /* En bloque: el revelado recorta el <picture>, y en línea su caja mide una
     línea de texto, no la foto. */
  .suelta :global(picture) {
    display: block;
  }

  .suelta :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 10;
    object-fit: cover;
  }

  @media (max-width: 47.99rem) {
    .fuera {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
      min-height: 0;
    }

    .fuera-centro {
      position: static;
      grid-column: 1 / -1;
      grid-row: 2;
      width: auto;
      transform: none;
    }

    h2 {
      font-size: 9vw;
    }

    .suelta {
      position: static;
      width: 78%;
    }

    .suelta:nth-of-type(odd) {
      justify-self: end;
    }

    .suelta:nth-of-type(even) {
      margin-top: 2.5rem;
    }

    .solo-escritorio {
      display: none;
    }
  }
</style>
