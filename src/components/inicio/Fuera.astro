---
// Fotografías reunidas alrededor de un título: lo que hay fuera de la
// habitación. Es el único descanso deliberado de la página; en la fase 4 cada
// foto se desplazará a su propio ritmo (parallax).
import Foto from "../Foto.astro";
import type { ClaveFoto } from "../../data/fotos";
import { ruta } from "../../lib/ruta";

// Posición en porcentaje de la banda (x, y) y ancho en px. Las marcadas con
// `movil` son las cinco que se quedan en pantallas estrechas.
const fotosBanda: { foto: ClaveFoto; x: number; y: number; ancho: number; movil?: boolean }[] = [
  { foto: "spaPiscina", x: 23, y: 6, ancho: 200, movil: true },
  { foto: "costaPlayaNegra", x: 44, y: 0, ancho: 170 },
  { foto: "mesaVino", x: 63, y: 9, ancho: 190, movil: true },
  { foto: "spaTumbonas", x: 20, y: 62, ancho: 170, movil: true },
  { foto: "nocheCielo", x: 40, y: 76, ancho: 190, movil: true },
  { foto: "costaRoca", x: 61, y: 66, ancho: 160 },
  { foto: "diaPoza", x: 70, y: 38, ancho: 180, movil: true },
];
---

<section class="fuera" aria-labelledby="fuera-titulo">
  <div class="fuera-centro">
    <h2 id="fuera-titulo">Fuera de<br />la habitación</h2>
    <p>Termas de agua de mar, la Mesa de Lumbre, una cala de arena negra y un cielo sin farolas.</p>
    <a class="enlace" href={ruta("experiencias")}>Ver las experiencias</a>
  </div>
  {
    fotosBanda.map((f) => (
      <div class:list={["suelta", { "solo-escritorio": !f.movil }]} style={`--x:${f.x}%;--y:${f.y}%;--ancho:${f.ancho}px`}>
        <Foto foto={f.foto} sizes={`${f.ancho}px`} anchos={[f.ancho, f.ancho * 2]} />
      </div>
    ))
  }
</section>

<style>
  .fuera {
    position: relative;
    min-height: 100svh;
    margin-top: var(--seccion);
    margin-inline: var(--margen);
  }

  .fuera-centro {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: min(28rem, 100%);
    transform: translate(-50%, -50%);
    text-align: center;
  }

  h2 {
    font-size: var(--step-head);
    line-height: 1;
  }

  .suelta {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--ancho);
  }

  .suelta :global(img) {
    width: 100%;
    aspect-ratio: 9 / 10;
    object-fit: cover;
  }

  @media (max-width: 47.99rem) {
    .fuera {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
      min-height: 0;
    }

    .fuera-centro {
      position: static;
      grid-column: 1 / -1;
      grid-row: 2;
      width: auto;
      transform: none;
    }

    h2 {
      font-size: 9vw;
    }

    .suelta {
      position: static;
      width: 78%;
    }

    .suelta:nth-of-type(odd) {
      justify-self: end;
    }

    .suelta:nth-of-type(even) {
      margin-top: 2.5rem;
    }

    .solo-escritorio {
      display: none;
    }
  }
</style>
